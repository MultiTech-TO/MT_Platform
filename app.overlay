

/ {
	chosen {
		zephyr,display = &display0;
	};

	aliases {
		lora0 = &lora0;
		pwm-led0 = &pwm_led0;
		sloan-uart = &eusart1;
	};


	pwmleds {
		compatible = "pwm-leds";

		pwm_led0: pwm_led_0 {
			pwms = <&timer0_pwm 0 PWM_MSEC(5) PWM_POLARITY_NORMAL>;
			label = "PWM LED 0";
		};
	};
};

&pinctrl{
	// The pins are different on this application so we redefine the pin control here
	clkout_default: clkout_default {
        group1 {
            pins = <CMU_CLKOUT2_PB3>;
        };
    };
	eusart0_default: eusart0_default {
		group0 {
			pins = <EUSART0_TX_PA4>, <EUSART0_SCLK_PA3>;
			drive-push-pull;
			output-high;
		};

		group1 {
			pins = <EUSART0_RX_PA5>;
			input-enable;
			silabs,input-filter;
		};
	};

	eusart0_sleep: eusart0_sleep {
		group0 {
			pins = <EUSART0_TX_PA4>, <EUSART0_RX_PA5>, <EUSART0_SCLK_PA3>;
		};
	};
	timer0_default: timer0_default {
		group0 {
			pins = <TIMER0_CC0_PC0>;
			drive-push-pull;
			output-low;
		};
	};

	i2c0_default: i2c0_default {
		group0 {
			pins = <I2C0_SCL_PB3>, <I2C0_SDA_PB2>;
			drive-open-drain;
			bias-pull-up;
		};
	};
};

&eusart1 {
	/delete-property/ cs-gpios; // EUSART1 was changed from LORA SPI to a USART for the Sloan Above Deck so delete the cs-pins
	/delete-node/ sx1262@0; // Remove the sx1262
	// compatible = "silabs,eusart-uart"; // Redefine as uart
	// current-speed = <4800>;
	// pinctrl-0 = <&eusart1_default>;
	// pinctrl-1 = <&eusart1_sleep>;
	// pinctrl-names = "default", "sleep";
	status = "disabled";
};

&eusart0 {
	compatible = "silabs,eusart-spi";
	status = "okay";
	pinctrl-0 = <&eusart0_default>;
	// pinctrl-1 = <&eusart0_sleep>;
	pinctrl-names = "default";
	cs-gpios = <&gpioa 0 GPIO_ACTIVE_LOW>, <&gpioc 3 GPIO_ACTIVE_LOW>;
	#address-cells = <1>;
	#size-cells = <0>;
	lora0: sx1262@0 {
		compatible = "semtech,sx1262";
		status = "okay";
		reg = <0>; // reg 0 refers to the first element of cs-gpio
		label = "sx1262";
		reset-gpios = <&gpioa 6 GPIO_ACTIVE_LOW>;
		busy-gpios = <&gpioa 7 GPIO_ACTIVE_HIGH>;
		// antenna-enable-gpios = <&gpiob 0 (GPIO_PULL_DOWN | GPIO_ACTIVE_HIGH)>;
		dio1-gpios = <&gpioa 8 (GPIO_PULL_DOWN | GPIO_ACTIVE_HIGH)>;
		dio2-tx-enable;
		spi-max-frequency = <1000000>;
		rx-boosted;
	};
	mipi_dbi {
		compatible = "zephyr,mipi-dbi-spi";
		spi-dev = <&eusart0>;

		dc-gpios = <&gpioc 2 GPIO_ACTIVE_HIGH>;
		reset-gpios = <&gpioc 5 GPIO_ACTIVE_LOW>;

		write-only;

		#address-cells = <1>;
		#size-cells = <0>;
		pinctrl-0 = <&eusart1_default>;
		pinctrl-names = "default";

		display0: st7796s@1 {
			compatible = "sitronix,st7796s";
			status = "okay";
			reg = <1>; // reg 0 refers to the first element of cs-gpio
			label = "lcd";
			mipi-max-frequency = <1000000>;
			mipi-mode = "MIPI_DBI_MODE_SPI_4WIRE";
			height = <240>;
			width = <240>;
			invert-mode = "1-dot";
			frmctl1 = [80 10];
			bpc = [1f 50 00 20];
			dfc = [8a 07 3b];
			pwr1 = [80 64];
			pwr2 = <0x13>;
			pwr3 = <0xa7>;
			vcmpctl = <0x09>;
			doca = [40 8a 00 00 29 19 a5 33];
			pgc = [f0 06 0b 07 06 05 2e 33 47 3a 17 16 2e 31];
			ngc = [f0 09 0d 09 08 23 2e 33 46 38 13 13 2c 32];
			madctl = <0x28>;
			rgb-is-inverted;
			// color-invert;
			color-coding = "MIPI_DBI_MODE_RGB565";
			/* LCD_TE tearing signal is not available in SPI PMOD connector */
			te-mode = "MIPI_DBI_TE_NO_EDGE";
		};
	};

};

&timer0 {
	status = "okay";

	timer0_pwm: pwm {
		pinctrl-0 = <&timer0_default>;
		pinctrl-names = "default";
		status = "okay";
	};
};

&lfrco {
	precision-mode;
};

&lfxo{
	ctune=<0x28>;
};

&usart0{
	status = "okay";
};

&i2c0 {
	status = "okay";
	pinctrl-0 = <&i2c0_default>;
	pinctrl-names = "default";

	co2_sensor: scd41@62 {
        compatible = "sensirion,scd41";
		status = "okay";
        reg = <0x62>;
        mode = <0>;
    };
};
