/ {
	chosen {
		zephyr,display = &display0;
	};

	aliases {
		lora0 = &lora0;
	};
};

&pinctrl {

	eusart0_default: eusart0_default {
		group0 {
			pins = <EUSART0_TX_PA4>, <EUSART0_SCLK_PA3>;
			drive-push-pull;
			output-high;
		};

		group1 {
			pins = <EUSART0_RX_PA5>;
			input-enable;
			silabs,input-filter;
		};
	};

	eusart0_sleep: eusart0_sleep {
		group0 {
			pins = <EUSART0_TX_PA4>, <EUSART0_RX_PA5>, <EUSART0_SCLK_PA3>;
		};
	};

	i2c0_default: i2c0_default {
		group0 {
			pins = <I2C0_SCL_PB3>, <I2C0_SDA_PB2>;
			drive-open-drain;
			bias-pull-up;
		};
	};
};

&eusart1 {
	/delete-property/ cs-gpios; // EUSART1 was changed from LORA SPI to a USART for the Sloan Above Deck so delete the cs-pins
	/delete-node/ sx1262@0; // Remove the sx1262
	status = "disabled";
};

&eusart0 {
	compatible = "silabs,eusart-spi";
	status = "okay";
	pinctrl-0 = <&eusart0_default>;
	// pinctrl-1 = <&eusart0_sleep>;
	pinctrl-names = "default";
	cs-gpios = <&gpioa 0 GPIO_ACTIVE_LOW>, <&gpioc 3 GPIO_ACTIVE_LOW>;
	#address-cells = <1>;
	#size-cells = <0>;

	lora0: sx1262@0 {
		compatible = "semtech,sx1262";
		status = "okay";
		reg = <0>; // reg 0 refers to the first element of cs-gpio
		label = "sx1262";
		reset-gpios = <&gpioa 6 GPIO_ACTIVE_LOW>;
		busy-gpios = <&gpioa 7 GPIO_ACTIVE_HIGH>;
		antenna-enable-gpios = <&gpiob 0 (GPIO_PULL_UP | GPIO_ACTIVE_HIGH)>;
		dio1-gpios = <&gpioa 8 (GPIO_PULL_DOWN | GPIO_ACTIVE_HIGH)>;
		dio2-tx-enable;
		spi-max-frequency = <1000000>;
		rx-boosted;
	};

	mipi_dbi {
		compatible = "zephyr,mipi-dbi-spi";
		spi-dev = <&eusart0>;

		dc-gpios = <&gpioc 2 GPIO_ACTIVE_HIGH>;
		reset-gpios = <&gpioc 5 GPIO_ACTIVE_LOW>;

		write-only;

		#address-cells = <1>;
		#size-cells = <0>;
		pinctrl-0 = <&eusart1_default>;
		pinctrl-names = "default";

		display0: st7796s@1 {
			compatible = "sitronix,st7796s";
			status = "okay";
			reg = <1>; // reg 0 refers to the first element of cs-gpio
			label = "lcd";
			mipi-max-frequency = <1000000>;
			mipi-mode = "MIPI_DBI_MODE_SPI_4WIRE";
			height = <240>;
			width = <240>;
			invert-mode = "1-dot";
			frmctl1 = [80 10];
			bpc = [1f 50 00 20];
			dfc = [8a 07 3b];
			pwr1 = [80 64];
			pwr2 = <0x13>;
			pwr3 = <0xa7>;
			vcmpctl = <0x09>;
			doca = [40 8a 00 00 29 19 a5 33];
			pgc = [f0 06 0b 07 06 05 2e 33 47 3a 17 16 2e 31];
			ngc = [f0 09 0d 09 08 23 2e 33 46 38 13 13 2c 32];
			madctl = <0x28>;
			rgb-is-inverted;
			// color-invert;
			color-coding = "MIPI_DBI_MODE_RGB565";
			/* LCD_TE tearing signal is not available in SPI PMOD connector */
			te-mode = "MIPI_DBI_TE_NO_EDGE";
		};
	};
};

&lfrco {
	precision-mode;
};

&lfxo {
	ctune = <0x28>;
};

&usart0 {
	status = "okay";
};

&i2c0 {
	status = "okay";
	pinctrl-0 = <&i2c0_default>;
	pinctrl-names = "default";

	light_sensor: veml7700@10 {
		compatible = "vishay,veml7700";
		status = "okay";
		reg = <0x10>;
		psm-mode = <0x0>;
	};
	// co2_sensor: scd41@62 {
	// compatible = "sensirion,scd41";
	// 	status = "okay";
	// reg = <0x62>;
	// mode = <0>;
	//     };
};

/* DEVICETREE-MANAGER-BEGIN: generated region, do not edit inside this block */
#include <dt-bindings/pinctrl/silabs/xg24-pinctrl.h>

&timer0_default {
    group0 {
        pins = < TIMER0_CC1_PB4 >;
    };
};
/* DEVICETREE-MANAGER-END */
