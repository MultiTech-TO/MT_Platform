#include <zephyr/dt-bindings/lora/sx126x.h>

/ {
    aliases{
		lora0 = &lora0;
    };
};

&pinctrl{
    eusart1_default: eusart1_default {
		group0 {
			pins = <EUSART1_TX_PC1>, <EUSART1_SCLK_PC3>;
			drive-push-pull;
			output-high;
		};

		group1 {
			pins = <EUSART1_RX_PC2>;
			input-enable;
			silabs,input-filter;
		};
	};

    usart0_default: usart0_default {
		group0 {
			pins = <USART0_TX_PA0>;
			drive-push-pull;
			output-high;
		};

		group1 {
			pins = <USART0_RX_PB5>;
			input-enable;
			silabs,input-filter;
		};
    };
};

&eusart1{
    status = "okay";
    cs-gpios = <&gpioc 0 GPIO_ACTIVE_LOW>;
    lora0: sx1262@2{
		compatible = "semtech,sx1262";
		reg = <2>;
		label = "sx1262";
		reset-gpios = <&gpioa 9 GPIO_ACTIVE_LOW>;
		busy-gpios = <&gpioa 7 GPIO_ACTIVE_HIGH>;
		tx-enable-gpios = <&gpioa 6 GPIO_ACTIVE_LOW>;
		dio1-gpios = <&gpioa 8 (GPIO_PULL_DOWN | GPIO_ACTIVE_HIGH)>; // dio1-gpios = <&gpio1 15 GPIO_ACTIVE_LOW>; 
		dio2-tx-enable;
		spi-max-frequency = <1000000>;
    };
};

&usart0 {
	current-speed = <115200>;
	pinctrl-0 = <&usart0_default>;
	pinctrl-names = "default";
	status = "okay";
};